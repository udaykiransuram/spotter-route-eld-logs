# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend
DJANGO_SECRET_KEY=spotter-local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=false
LOCATION_SUGGEST_RATE=120/minute
TRIP_PLAN_RATE=30/hour

# Optional explicit production overrides. Leave unset locally; when
# DJANGO_DEBUG=false these already default to the secure values shown here.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true

# Routing
GEOAPIFY_API_KEY=
USE_DEMO_PROVIDER=true
ROUTING_TIMEOUT_SECONDS=12
